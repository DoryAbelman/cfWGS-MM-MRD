# ==============================================================================
# cfWGS-MM-MRD GitHub ignore rules
# ==============================================================================
#
# This .gitignore belongs to the nested Git repository rooted at:
#
#   Scripts_2025/Final_Scripts/
#
# It is the file shown in GitHub Desktop in the screenshot. The broader
# project-level allowlist lives one directory tree above this nested repo:
#
#   ../../.gitignore
#
# The local Code Ocean/capsule tree is not part of this GitHub repository.
# ==============================================================================

# ------------------------------------------------------------------------------
# Local/editor/session state.
# These files are machine-specific and are not part of the analysis repository.
# ------------------------------------------------------------------------------

# macOS metadata
.DS_Store

# R session artefacts
.Rhistory
.RData
.Rproj.user/

# Editor backup files
*.bak

# ------------------------------------------------------------------------------
# Local environments and developer tooling.
# The analysis scripts declare package requirements; local virtual environments
# and IDE/copilot metadata should not be uploaded.
# ------------------------------------------------------------------------------

# Python virtual environment (used only by VS Code tooling, not analysis code)
.venv/
.github/copilot-instructions.md

# ------------------------------------------------------------------------------
# Archived, exploratory, and scratch source folders.
# ------------------------------------------------------------------------------

Other/
Tmp/
figures/
Scripts prior to rerunning ML model/
For targetted panel MS/

# ------------------------------------------------------------------------------
# Generated run logs and local input reports.
# These are regenerated by the command-line wrappers and are intentionally local.
# ------------------------------------------------------------------------------

pipeline_logs/20260617_144955/run_manifest.tsv
/pipeline_logs
/clean_pipeline/logs
local_input_check_report.tsv
/output_comparison_4_1_examples

# ------------------------------------------------------------------------------
# Generated manuscript output trees.
# These are useful locally but should not be committed from this nested repo.
# Final result files are selected separately rather than committing whole local
# output trees.
# ------------------------------------------------------------------------------

/outputs
/final_manuscript_objects
/manuscript_writing
/Output_figures_2025

# Local capsule-building tree and scripts.
/public_reproducibility/
/5_5_Build_CodeOcean_Capsule.R
/5_5_Build_Response_Only_Figures.R
/5_6_Package_CodeOcean_Capsule.R
/5_7_Rebuild_CodeOcean_Public_Workbooks.R
/5_8_Build_CodeOcean_Analysis_Layer.R
/CODE_OCEAN_UPLOAD_CHECKLIST.md

# Mutation-tracking analyses are not included in the current manuscript.
/4_2B_FZ07_mutation_tracking_evolution.R
/4_2C_Audit_BM_informed_declines_before_relapse.R
/4_2D_Build_patient_BM_vs_blood_mutation_tracks.R
/4_2E_Longitudinal_BM_blood_mutation_evolution.R
/4_2F_Compare_baseline_vs_relapse_WGS_mutation_lists.R
/4_2G_Baseline_relapse_WGS_mutation_evolution.R
/4_2H_Supplementary_WGS_subclonal_evolution_figure.R

# Optional IgCaller mini-BAM helpers remain local until their duplicate-call
# handling has been checked against the review manifest.
/1_3b_Prepare_IgCaller_MiniBAM_Regions.R
/1_3b_Create_IgCaller_IGV_MiniBAMs.sh

# Compatibility wrapper; the active operation is documented for 3_1 directly.
/3_1B_Refresh_test_cohort_confusion_panels.R

# Working audit notes and README proposal. Material intended for GitHub is
# incorporated into README.md and the final script guide after review.
/docs/SCRIPT_REVIEW_*.md
/docs/RELEASE_FILE_SELECTION.md
/docs/README_DRAFT.md
/docs/PROPOSED_SCRIPT_ORDER_AND_REPOSITORY_STRUCTURE.md
/docs/PUBLICATION_TABLES.md
/docs/SUPPLEMENTARY_TABLE_RECONCILIATION.md
/docs/artifact_regeneration_status.tsv
/docs/manuscript_artifact_source_map.tsv
/docs/stage_ordered_script_artifact_map.md
/docs/stage_ordered_script_artifact_map.tsv

# ------------------------------------------------------------------------------
# Archive policy.
# Most archive content is intentionally excluded. The support-analysis subfolder
# is retained because it contains study-related sensitivity analyses.
# ------------------------------------------------------------------------------

/archive/*
!/archive/support_analysis/
!/archive/support_analysis/**

# ------------------------------------------------------------------------------
# Agent/runtime instruction files.
# Keep local agent instructions out of the public source-pipeline repo unless
# deliberately reviewed for publication.
# ------------------------------------------------------------------------------

AGENTS.md
